# Portable build of the team-sync Core Service. The desktop app stays a
# native Electron build per platform; THIS image is what private-deploy
# operators (and the bundled `docker compose --profile server up`) run.
#
# Multi-stage:
#   1. build — install full deps, compile TypeScript via tsconfig.server.json
#   2. runtime — alpine base, only the server's runtime deps installed
#
# Hardening notes:
#   - Pinned base tag (override with --build-arg NODE_IMAGE=...)
#   - Non-root `node` user (uid 1000)
#   - Read-only root filesystem at runtime (compose contract)
#   - tini as PID 1 to reap children + forward signals
#   - HEALTHCHECK hits /healthz; LCM_SERVER_PORT defaults to 4017
#
# `better-sqlite3` is desktop-only (reads the Cursor IDE's own
# auth-token store) — it is never imported by the server, so we skip
# its postinstall via --ignore-scripts in the build stage and don't
# install it at all in the runtime stage.

ARG NODE_IMAGE=node:20.18.1-alpine

# ── Stage 1: compile TypeScript ───────────────────────────────────────
FROM ${NODE_IMAGE} AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

COPY tsconfig.json tsconfig.server.json ./
COPY server ./server
COPY src ./src
RUN npx tsc -p tsconfig.server.json

# ── Stage 2: runtime ──────────────────────────────────────────────────
FROM ${NODE_IMAGE} AS runtime
ENV NODE_ENV=production \
    NPM_CONFIG_LOGLEVEL=warn \
    LCM_SERVER_PORT=4017 \
    LCM_SERVER_BIND=0.0.0.0
WORKDIR /app

# tini for proper PID 1 behavior (signal forwarding, zombie reap).
# wget for HEALTHCHECK; ca-certificates for outbound HTTPS (JWKS).
RUN apk add --no-cache tini wget ca-certificates

# Install only the runtime deps the server actually imports. Versions
# track package.json so prod and dev stay in sync.
# jose pinned to v5 (CommonJS-compatible). v6 is ESM-only, and the server
# compiles to CommonJS (tsconfig.server.json), so `require("jose")` from v6
# throws ERR_REQUIRE_ESM and crash-loops the container. v5 is API-compatible
# for createRemoteJWKSet / jwtVerify / decodeJwt — the only jose APIs used.
RUN echo '{"name":"lcm-server-runtime","private":true}' > package.json && \
    npm install --omit=optional --omit=dev --no-audit --no-fund --no-package-lock \
      pg@8.20.0 jose@5.9.6 && \
    npm cache clean --force

# Compiled JS preserves the source layout (out-server/server/*.js,
# out-server/src/...). `__dirname` at runtime is /app/out-server/server,
# and server/index.ts resolves migrations relative to that.
COPY --from=build --chown=node:node /app/out-server ./out-server
COPY --chown=node:node server-migrations ./out-server/server-migrations

# Drop privileges. The `node` user (uid 1000) ships with the base image.
USER node
EXPOSE 4017

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -qO- "http://127.0.0.1:${LCM_SERVER_PORT}/healthz" || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "out-server/server/index.js"]
