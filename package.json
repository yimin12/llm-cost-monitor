{
  "name": "llm-cost-monitor",
  "version": "0.0.1",
  "description": "macOS + Linux tray app that tracks LLM token usage and cost across providers — local-only, no telemetry",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "server:dev": "tsx server/index.ts",
    "server:db:up": "docker compose up -d server-postgres || docker compose up -d postgres",
    "server:migrate": "tsx server/migrate.ts",
    "server:up": "docker compose --profile server up -d --build",
    "server:down": "docker compose --profile server stop server",
    "server:logs": "docker compose logs -f server",
    "server:build": "docker compose --profile server build server",
    "lint": "eslint src",
    "test": "vitest run",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker compose exec postgres psql -U lcm -d llm_cost_monitor",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:migrate": "docker compose --profile migrate run --rm migrate-desktop && docker compose --profile migrate run --rm migrate-server",
    "db:migrate:desktop": "docker compose --profile migrate run --rm migrate-desktop",
    "db:migrate:server": "docker compose --profile migrate run --rm migrate-server",
    "prisma:desktop:dev": "prisma migrate dev --schema prisma/desktop/schema.prisma",
    "prisma:server:dev": "prisma migrate dev --schema prisma/server/schema.prisma",
    "prisma:status": "prisma migrate status --schema prisma/desktop/schema.prisma && prisma migrate status --schema prisma/server/schema.prisma",
    "predev": "npm run db:up && electron-builder install-app-deps",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist": "npm run build && electron-builder --mac --linux",
    "smoke:auth": "tsx bin/auth-smoke.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^12.9.0",
    "jose": "^6.2.3",
    "lenis": "^1.3.23",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^30.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "embedded-postgres": "^17.9.0-beta.17",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.3",
    "prisma": "^6.19.3",
    "puppeteer-core": "^22.15.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.4",
    "vite": "^5.3.4",
    "vitest": "^2.0.5"
  }
}
