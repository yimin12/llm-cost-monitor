{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "out-server",
    "baseUrl": ".",
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": ["node_modules", "out", "out-server", "dist"]
}
