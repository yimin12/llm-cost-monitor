# Optional per-machine overrides. The repo already ships with a bundled
# Google OAuth client in src/shared/oauth-config.ts that works out of
# the box (a fresh clone can `npm run dev` and sign in immediately).
#
# Only populate this file when you want to override the bundled client
# with one of your own — e.g. binding to a separate GCP project for
# CI / staging / abuse-isolated personal development. Env values win
# over the bundled defaults.

# Override the bundled Desktop OAuth client_id.
# GCP_CLIENTID=<your-id>.apps.googleusercontent.com

# Override the bundled Desktop OAuth client_secret. Optional even when
# overriding — Desktop OAuth + PKCE accepts a missing secret.
# GCP_CLIENTSECRET=GOCSPX-<your-secret>

# ─── Prisma migration runner (unrelated to auth) ──────────────────
# Connection strings used by the Prisma migration runner. Default
# values target the dev Postgres container in docker-compose.yml
# (bound to 127.0.0.1:5433). Inside the dockerized migration containers,
# the host is `postgres` and the port is 5432 — see Dockerfile.migrate
# and the `migrate-desktop` / `migrate-server` services.

# Used by `npm run prisma:desktop:dev` and `npm run prisma:status`.
LCM_DATABASE_URL=postgres://lcm:lcm_dev@127.0.0.1:5433/llm_cost_monitor

# Used by `npm run prisma:server:dev` and `npm run prisma:status`.
LCM_SERVER_DATABASE_URL=postgres://lcm:lcm_dev@127.0.0.1:5433/lcm_team_sync
