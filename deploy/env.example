# Production deploy secrets/config for docker-compose.prod.yml.
# Copy to the repo root as `.env` (which is gitignored) and fill in real values:
#   cp deploy/env.example .env
#
# Generate a strong DB password, e.g.:  openssl rand -base64 24

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=lcm
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
# Pin by digest in prod (find it with: docker buildx imagetools inspect postgres:17.2-alpine)
POSTGRES_IMAGE=postgres:17.2-alpine

# ── Team-sync server ─────────────────────────────────────────────────────────
# Verify Google ID tokens against JWKS. AUDIENCE = the desktop OAuth client_id
# (see src/shared/oauth-config.ts). Leaving AUTH unset would warn + accept
# unverified tokens — do NOT do that in production.
LCM_SERVER_AUTH=jwks
LCM_SERVER_AUDIENCE=CHANGE_ME_desktop_oauth_client_id
LCM_MAX_DEVICES_PER_USER=5

# ── TLS / Caddy ──────────────────────────────────────────────────────────────
LCM_SYNC_DOMAIN=sync.example.com
LCM_ACME_EMAIL=you@example.com

# ── Backups (deploy/backup.sh) ───────────────────────────────────────────────
# rclone remote name + bucket path the dumps are uploaded to.
# Configure the remote once with: rclone config   (Backblaze B2 or Cloudflare R2)
BACKUP_RCLONE_REMOTE=b2:llm-cost-monitor-backups
BACKUP_RETENTION_DAYS=30
