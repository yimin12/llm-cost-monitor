# Image used by `docker compose run --rm migrate-desktop` /
# `migrate-server` to apply Prisma migrations against the
# corresponding dev/CI/production database. Kept tiny on purpose:
# only `prisma` is installed, no app source, no @prisma/client.
#
# Build context is the repo root so we can copy `prisma/`. We pin the
# Prisma version to keep migrate output deterministic across
# developer machines.

FROM node:20-alpine

# Install only the prisma CLI. The container runs `prisma migrate deploy`
# and exits — no long-running process, so global install is fine.
ENV PRISMA_VERSION=6.19.3

RUN apk add --no-cache openssl ca-certificates && \
    npm install --global prisma@${PRISMA_VERSION}

WORKDIR /app

# Schemas + their tracked migration history. Mounting via compose at
# runtime would also work, but baking them in lets us tag the migrate
# image and run it in CI without the full repo.
COPY prisma /app/prisma

# Default to applying both schemas. Override by passing a different
# command (e.g. `--schema prisma/server/schema.prisma`).
CMD ["sh", "-c", "prisma migrate deploy --schema prisma/desktop/schema.prisma && prisma migrate deploy --schema prisma/server/schema.prisma"]
