# Image used by `docker compose run --rm migrate-desktop` /
# `migrate-server` to apply Prisma migrations against the
# corresponding dev/CI/production database. Kept tiny on purpose:
# only `prisma` is installed, no app source, no @prisma/client.
#
# Build context is the repo root so we can copy `prisma/`. The Prisma
# version is pinned to keep migrate output deterministic across
# developer machines.

ARG NODE_IMAGE=node:20.18.1-alpine
FROM ${NODE_IMAGE}

ENV PRISMA_VERSION=6.19.3

# tini reaps any spawned children before the migrate command exits.
# openssl is required by Prisma's binary engines; ca-certificates lets
# `prisma migrate deploy` reach https-protected schema mirrors.
RUN apk add --no-cache tini openssl ca-certificates && \
    npm install --global --no-audit --no-fund prisma@${PRISMA_VERSION} && \
    npm cache clean --force

WORKDIR /app
COPY --chown=node:node prisma /app/prisma

USER node

ENTRYPOINT ["/sbin/tini", "--"]
# Default to applying both schemas. Override by passing a different
# command (e.g. `prisma migrate deploy --schema prisma/server/schema.prisma`).
CMD ["sh", "-c", "prisma migrate deploy --schema prisma/desktop/schema.prisma && prisma migrate deploy --schema prisma/server/schema.prisma"]
